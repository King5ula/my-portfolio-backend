# Copy to .env. Every setting is read in app/config.py.

# "openrouter" calls a real model and needs OPENROUTER_API_KEY.
# "mock" returns a canned reply: no key, no network.
LLM_BACKEND=mock
OPENROUTER_API_KEY=
# Comma-separated, tried in order until one answers.
OPENROUTER_MODELS=nvidia/nemotron-3.5-lightning:free,liquid/lfm-2.5-2.6b:free,poolside/laguna-s-2.1:free

# Contact form (SMTP over SSL)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=
EMAIL_RECEIVER=

# Browser origins allowed to call this API
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_ORIGIN_REGEX=^https://my-portfolio-frontend(-[a-z0-9]+)*\.vercel\.app$
